# This is a template for the kfet/homebrew-ai tap.
#
# Formula/acp-router.rb in the tap is regenerated automatically by
# GoReleaser on every kfet/acp-router tag push (see the brews: block
# in .goreleaser.yaml). This file is kept in the main repo purely as a
# reference — it is NOT the file Homebrew reads, and edits here do not
# affect users.
#
# Users install with:
#   brew install kfet/ai/acp-router
#   (or: brew tap kfet/ai && brew install acp-router)

class AcpRouter < Formula
  desc "ACP-to-ACP router: one agent upstream, one ACP agent per user downstream"
  homepage "https://github.com/kfet/acp-router"
  license "MIT"

  # GoReleaser replaces url, sha256, and version on each release.
  url "https://github.com/kfet/acp-router/releases/download/v0.1.0/acp-router-#{OS}-#{ARCH}"
  version "0.1.0"
  sha256 "PLACEHOLDER"

  def install
    bin.install Dir["acp-router-*"].first => "acp-router"
  end

  test do
    system bin/"acp-router", "--version"
  end
end
